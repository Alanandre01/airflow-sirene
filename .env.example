# Airflow
AIRFLOW_UID=50000
FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=
AIRFLOW__API_AUTH__JWT_ISSUER=airflow

# AWS (bucket alan-data-lake-fr, région eu-west-1)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Snowflake (auth par clé RSA, voir keys/rsa_key.p8)
SNOWFLAKE_ACCOUNT=orgname-accountname
SNOWFLAKE_USER=
SNOWFLAKE_DATABASE=ALAN_DW
SNOWFLAKE_WAREHOUSE=ALAN_WH
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_PRIVATE_KEY_PATH=keys/rsa_key.p8
# SNOWFLAKE_PASSWORD=  # Vestige d'avant le passage à l'auth RSA (M3) — aucune connexion/DAG ne l'utilise. Ne pas décommenter sauf retour à l'auth password.

# dbt (chemin local monté dans le container à /opt/airflow/.dbt)
DBT_HOME=C:/Users/<user>/.dbt

# dbt project sirene_nantes (monté à /opt/airflow/dbt/sirene_nantes)
SIRENE_NANTES_DIR=C:/path/to/sirene_nantes

# Databricks
DATABRICKS_HOST=https://YOUR_WORKSPACE.azuredatabricks.net
DATABRICKS_TOKEN=
